# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored, so keys never end up in the repo.
#
# Free YouTube Data API v3 key — enables full-length playback.
# Without it the app falls back to 30-second iTunes previews.
# You can also paste a key inside the app (Settings) instead.
VITE_YOUTUBE_API_KEY=
